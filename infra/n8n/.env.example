# Copiar a .env (no se commitea). Generar la clave con: openssl rand -hex 32
# Guardar N8N_ENCRYPTION_KEY en el gestor de contraseñas del equipo: sin ella
# las credenciales guardadas en n8n no se pueden recuperar.
N8N_ENCRYPTION_KEY=

# Versiones fijas (no usar latest)
N8N_VERSION=2.44.2
CLOUDFLARED_VERSION=2026.10.1

# Local por defecto. Con túnel, usar el hostname público (sin https:// en N8N_HOST).
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Solo para docker-compose.named.yml
CLOUDFLARE_TUNNEL_TOKEN=
