    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function toCount(value) {\n  const n = Math.trunc(Number(value));\n  return Number.isFinite(n) && n > 0 ? n : 0;\n}\n\nfunction isExpired(order, now) {\n  if (!order || order.estado !== 'PENDIENTE_RECETA') return false;\n  const raw = order.fecha_expiracion;\n  if (raw === null || raw === undefined || raw === '') return false;\n  const expiresAt = new Date(raw);\n  if (Number.isNaN(expiresAt.getTime())) return false;\n  const reference = now instanceof Date ? now : new Date(now);\n  if (Number.isNaN(reference.getTime())) return false;\n  return expiresAt.getTime() <= reference.getTime();\n}\n\nfunction selectExpiredOrders(orders, now) {\n  const source = Array.isArray(orders) ? orders : [];\n  return source.filter((order) => isExpired(order, now));\n}\n\nfunction findInventoryRow(inventoryRows, medicamentoId) {\n  const source = Array.isArray(inventoryRows) ? inventoryRows : [];\n  const key = String(medicamentoId);\n  return source.find((row) => row && String(row.medicamento_id) === key) || null;\n}\n\nfunction currentReserved(inventoryRows, medicamentoId) {\n  const row = findInventoryRow(inventoryRows, medicamentoId);\n  return row ? Math.max(0, toCount(row.stock_reservado)) : 0;\n}\n\nfunction aggregateInventoryUpdates(expiredOrders, inventoryRows, now) {\n  const nowIso = (now instanceof Date ? now : new Date(now)).toISOString();\n  const totals = new Map();\n  (expiredOrders || []).forEach((order) => {\n    const key = String(order.medicamento_id);\n    totals.set(key, (totals.get(key) || 0) + toCount(order.cantidad));\n  });\n  const updates = [];\n  totals.forEach((totalCantidad, key) => {\n    const row = findInventoryRow(inventoryRows, key);\n    if (!row) return;\n    const current = Math.max(0, toCount(row.stock_reservado));\n    const newReserved = Math.max(0, current - totalCantidad);\n    updates.push({\n      medicamento_id: row.medicamento_id,\n      stock_reservado: newReserved,\n      delta_reservado: newReserved - current,\n      clamped: totalCantidad > current,\n      ultima_actualizacion: nowIso,\n    });\n  });\n  return updates;\n}\n\nfunction distributeReleases(expiredOrders, inventoryRows) {\n  const releasedSoFar = new Map();\n  return (expiredOrders || []).map((order) => {\n    const key = String(order.medicamento_id);\n    const reserved = currentReserved(inventoryRows, key);\n    const wanted = toCount(order.cantidad);\n    const already = releasedSoFar.get(key) || 0;\n    const left = Math.max(0, reserved - already);\n    const released = Math.min(wanted, left);\n    releasedSoFar.set(key, already + released);\n    return { released: released, clamped: released < wanted };\n  });\n}\n\nfunction buildBitacoraRows(expiredOrders, inventoryRows, now) {\n  const nowIso = (now instanceof Date ? now : new Date(now)).toISOString();\n  const plan = distributeReleases(expiredOrders, inventoryRows);\n  return (expiredOrders || []).map((order, index) => {\n    const entry = plan[index];\n    let detalle =\n      'Expiracion 12h: liberadas ' +\n      entry.released +\n      ' de ' +\n      toCount(order.cantidad) +\n      ' unidades reservadas';\n    if (entry.clamped) detalle += '; CLAMP: stock_reservado insuficiente';\n    return {\n      timestamp: nowIso,\n      accion: 'EXPIRACION',\n      codigo_far: order.codigo_far,\n      medicamento_id: order.medicamento_id,\n      delta_reservado: -entry.released,\n      detalle: detalle,\n      estado_anterior: 'PENDIENTE_RECETA',\n      estado_nuevo: 'CANCELADO_EXPIRADO',\n      actor: 'sistema:cron',\n    };\n  });\n}\n\nfunction buildExpiryMessage(order, released, catalogRow) {\n  const code = order && order.codigo_far ? String(order.codigo_far) : '';\n  let message =\n    'Tu pedido #' +\n    code +\n    ' fue cancelado por falta de receta después de 12 horas.';\n  if (catalogRow && catalogRow.nombre_comercial) {\n    message +=\n      ' Liberamos ' +\n      released +\n      ' unidades de ' +\n      catalogRow.nombre_comercial +\n      ' al stock.';\n  }\n  return message;\n}\n\nfunction buildNotifications(expiredOrders, inventoryRows, catalogRows) {\n  const plan = distributeReleases(expiredOrders, inventoryRows);\n  const source = Array.isArray(catalogRows) ? catalogRows : [];\n  return (expiredOrders || []).map((order, index) => {\n    const key = String(order.medicamento_id);\n    const catalogRow =\n      source.find((row) => row && String(row.medicamento_id) === key) || null;\n    return {\n      // The `telefono` column stores the Telegram chat id captured at order\n      // creation (column name kept for the sheet schema); the payload field is chat_id.\n      chat_id: order.telefono,\n      message: buildExpiryMessage(order, plan[index].released, catalogRow),\n    };\n  });\n}\n\nfunction buildExpiryPlan(expiredOrders, inventoryRows, catalogRows, now) {\n  return {\n    inventoryUpdates: aggregateInventoryUpdates(expiredOrders, inventoryRows, now),\n    bitacoraRows: buildBitacoraRows(expiredOrders, inventoryRows, now),\n    notifications: buildNotifications(expiredOrders, inventoryRows, catalogRows),\n  };\n}\n\n// --- n8n data assembly -------------------------------------------------------\n// Guarded: outside the editor (test harness) `$` does not exist, so this block\n// stays inert and only the named functions above are reachable.\nif (typeof $ !== 'undefined') {\n  const now = new Date();\n  const ordenes = $('read_ordenes').all().map((item) => item.json);\n  const inventario = $('read_inventario').all().map((item) => item.json);\n  const catalogo = $('read_catalogo').all().map((item) => item.json);\n  const expired = selectExpiredOrders(ordenes, now);\n  const plan = buildExpiryPlan(expired, inventario, catalogo, now);\n  return [\n    {\n      json: {\n        count: expired.length,\n        expired: expired,\n        inventoryUpdates: plan.inventoryUpdates,\n        bitacoraRows: plan.bitacoraRows,\n        notifications: plan.notifications,\n      },\n    },\n  ];\n}\n"
      },
      "id": "n05",
      "name": "find_expired",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "notes": "RF-06: selects PENDIENTE_RECETA orders with fecha_expiracion <= now (inclusive, date-parsed), aggregates stock release per medicamento_id, clamps at 0, builds bitacora rows (accion EXPIRACION) and Telegram messages. Emits exactly one item."
    },
