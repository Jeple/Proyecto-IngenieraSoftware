# =============================================================================
# Plantilla de configuración local. Cópiela como .env (el script de arranque
# scripts/local/levantar lo hace por usted y genera las claves automáticas).
# .env está en .gitignore: NUNCA se sube al repositorio ni se pega en chats.
# Guía paso a paso: docs/guia-instalacion-local.md
# =============================================================================

# --- Generadas automáticamente por scripts/local/levantar --------------------
# Clave con la que n8n cifra las credenciales guardadas. Si la pierde, hay que
# volver a importar la credencial de Google (vuelva a ejecutar levantar).
N8N_ENCRYPTION_KEY=
# Secreto que Telegram envía en cada webhook (X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=

# --- Bot de Telegram (obligatorio) -------------------------------------------
# Token que entrega @BotFather al crear el bot (/newbot).
TELEGRAM_BOT_TOKEN=
# chat_id de los químicos farmacéuticos que aprueban o rechazan recetas,
# separados por comas. Su chat_id se obtiene escribiendo a @userinfobot.
TELEGRAM_PHARMACIST_CHAT_IDS=
# chat_id del personal que marca "en ruta" y "entregado" (US-22). Si queda
# vacío, se usa la lista de farmacéuticos.
TELEGRAM_STAFF_CHAT_IDS=
# chat_id que recibe las alertas cuando un flujo falla (US-21).
TELEGRAM_ADMIN_CHAT_ID=

# --- Google (obligatorio) ----------------------------------------------------
# ID de la planilla (la parte larga de la URL entre /d/ y /edit), compartida
# como Editor con el client_email de la cuenta de servicio.
GOOGLE_SHEET_ID=
# Ruta del JSON de la cuenta de servicio. La carpeta secrets/ está ignorada.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
# ID de la carpeta de recetas en SU Drive (RNF-07). Las recetas se suben con
# OAuth (cliente en secrets/oauth-client.json, credencial «Google Drive (OAuth)»
# conectada en el editor): la cuenta de servicio tiene cuota 0. Guía, paso 6.
GOOGLE_DRIVE_RECETAS_FOLDER_ID=

# --- Opcional ----------------------------------------------------------------
# Respaldo para clasificar mensajes ambiguos (US-17). Sin clave, el router usa
# solo reglas y responde con el menú de ayuda.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Versiones fijadas de las imágenes (cambiarlas solo en un PR probado).
N8N_VERSION=2.44.2
CLOUDFLARED_VERSION=2026.10.1
# Solo para el túnel con nombre (perfil tunel-nombrado).
CF_TUNNEL_TOKEN=
# Base de la API de Telegram; la prueba de integración la apunta a un simulador.
TELEGRAM_API_BASE=https://api.telegram.org

# Fuera del alcance firmado de este semestre (no se configuran):
#   voz (Vapi, US-08), recetas por correo (IMAP, US-19), app del conductor (US-11).
