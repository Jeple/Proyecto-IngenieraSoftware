# ============================================================================
# NEVER commit the real .env file. Copy this template to .env and fill in
# your own values. The real .env is git-ignored and must stay out of git.
# ============================================================================

# n8n: random 32+ char string used to encrypt credentials at rest.
# Generate with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=

# Public hostname served by the Cloudflare Tunnel (without protocol),
# e.g. n8n-mi-tunel.example.com
N8N_HOST=

# Cloudflare Tunnel token (Zero Trust dashboard -> Tunnels -> token)
CF_TUNNEL_TOKEN=

# Google Sheets spreadsheet ID (the long id in the sheet URL)
GOOGLE_SHEET_ID=

# Host path to the Google service-account JSON. Copy that file into ./secrets/
# (mounted into the n8n container at /home/node/.n8n/secrets).
GOOGLE_SERVICE_ACCOUNT_FILE=

# Gemini Flash API key (Google AI Studio)
GEMINI_API_KEY=

# REQUIRED - active channel (US-09 recipe ingestion by photo).
# Bot token: create the bot with @BotFather in Telegram. Webhook secret: any
# random string you choose, sent on every incoming webhook request.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Optional - US-09 email channel (deferred to a later version; Telegram is the
# active channel). Leave empty until the email channel is enabled.
# ----------------------------------------------------------------------------
# IMAP inbox used to receive prescription emails (US-09 email path).
# IMAP user/password are stored in the n8n credential, never in this file.
IMAP_HOST=
IMAP_PORT=993
IMAP_MAILBOX=INBOX

# Google Drive folder that stores the received prescriptions (US-09 email path).
GOOGLE_DRIVE_RECETAS_FOLDER_ID=

# Vapi voice agent
VAPI_API_KEY=
VAPI_ASSISTANT_ID=

# OSRM base URL (public demo server, no API key required)
OSRM_BASE_URL=https://router.project-osrm.org
